# Stowkeeper pilot configuration — {{ ansible_hostname }}
# Generated by Ansible — {{ ansible_date_time.iso8601 }}

# Repositories
REPOS=({% for repo in stowkeeper_repos %}"{{ repo }}" {% endfor %})

# NAS repository
RESTIC_REPOSITORY_nas="sftp:{{ stowkeeper_nas_user }}@{{ stowkeeper_nas_host }}:{{ stowkeeper_nas_path }}"
RESTIC_PASSWORD_FILE_nas="{{ stowkeeper_install_dir }}/conf/nas-passphrase"

{% if 'b2' in stowkeeper_repos %}
# B2 repository
RESTIC_REPOSITORY_b2="s3:{{ stowkeeper_b2_bucket_url }}"
RESTIC_PASSWORD_FILE_b2="{{ stowkeeper_install_dir }}/conf/b2-passphrase"
B2_ACCOUNT_ID="{{ stowkeeper_b2_account_id }}"
B2_ACCOUNT_KEY="{{ vault_stowkeeper_b2_app_key }}"
{% endif %}

# Vault
VAULT_ADDR="{{ stowkeeper_vault_addr }}"
VAULT_ROLE_ID="{{ vault_stowkeeper_role_id }}"
VAULT_SECRET_ID="{{ vault_stowkeeper_secret_id }}"

# Retention
RETENTION_POLICY="--keep-last 3 --keep-hourly 24 --keep-daily 14 --keep-weekly 8 --keep-monthly 12 --keep-yearly 5"

# Database
{% if stowkeeper_db_type | length > 0 %}
DB_TYPE="{{ stowkeeper_db_type }}"
DB_NAME="{{ stowkeeper_db_name | default('') }}"
DB_USER="{{ stowkeeper_db_user | default('') }}"
{% endif %}

# Notifications
TELEGRAM_BOT_TOKEN="{{ stowkeeper_telegram_bot_token }}"
TELEGRAM_CHAT_ID="{{ stowkeeper_telegram_chat_id }}"
SMTP_HOST="{{ stowkeeper_smtp_host }}"
SMTP_PORT="{{ stowkeeper_smtp_port | default(587) }}"
SMTP_FROM="{{ stowkeeper_smtp_from }}"
SMTP_USER="{{ stowkeeper_smtp_user | default('') }}"
SMTP_PASS="{{ vault_stowkeeper_smtp_pass | default('') }}"
ALERT_EMAIL="{{ stowkeeper_alert_email | default('') }}"

# Paths
STOWKEEPER_INSTALL_DIR="{{ stowkeeper_install_dir }}"
METRICS_FILE="{{ stowkeeper_metrics_file | default('') }}"
