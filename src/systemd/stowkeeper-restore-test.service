[Unit]
Description=Stowkeeper quarterly restore test
After=network.target

[Service]
Type=oneshot
User=stowkeeper
EnvironmentFile=-/opt/stowkeeper/conf/pilot.conf
RuntimeDirectory=stowkeeper
ExecStart=/opt/stowkeeper/lib/stowkeeper-restore-test.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=stowkeeper-restore-test
